{
  "name": "@reach/server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('public','dist/public',{recursive:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-timeout=30000 \"src/**/*.test.ts\"",
    "doctor": "tsx src/doctor.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.637.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.16.2",
    "typescript": "^5.6.3"
  }
}
