# REACH configuration — copy to `.env` (repo root) and fill in. NEVER commit `.env`.
# Every variable below is documented; `npm run doctor` verifies this file.

# --- AWS / Bedrock (needed for live planning; mock covers tests) ---
# Create: IAM user + access key (Bedrock full access for dev), Bedrock model access in console.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Default planner model. Nova Pro (strongest reasoning in the family; used
# because Nova Lite looped on unexpected 404s/obstacles — see the friction
# log). Requires Bedrock model access to be enabled for your account.
# Fallback (cheaper, faster): amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
# Free LangSearch API key (https://langsearch.com/api-keys) — preferred search backend
LANGSEARCH_API_KEY=your_key_here

# --- Core <-> agent channel (REQUIRED — both processes refuse to boot without it) ---
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Same value must be set wherever the server AND the agent run.
AGENT_TOKEN=

# --- Ports / URLs ---
PORT=3000
AGENT_PORT=3001
CORE_URL=http://localhost:3000
AGENT_URL=http://localhost:3001

# --- Runtime tuning (all optional, defaults shown) ---
# REACH_DATA_DIR=<server-cwd>/data
# DEVICE_TIMEOUT_MS=90000
# HEARTBEAT_INTERVAL_MS=30000
# DISPATCH_TIMEOUT_MS=60000
# APPROVAL_TTL_MS=600000
# PLANNER_MAX_STEPS=8
