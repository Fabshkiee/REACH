{
  "name": "@reach/video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion video editing suite for REACH demo submission",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "dev": "remotion preview src/index.ts",
    "build": "remotion render src/index.ts ReachDemo out/reach-demo.mp4",
    "render": "remotion render src/index.ts ReachDemo out/reach-demo.mp4",
    "render:fast": "remotion render src/index.ts ReachDemo out/reach-demo.mp4 --concurrency=4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.218",
    "@remotion/transitions": "^4.0.218",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.218"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
